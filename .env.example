# Token lấy từ @BotFather
BOT_TOKEN=

# Tính năng "Tham chiếu kịch bản" (upload video >20MB): Telegram Bot API chỉ
# cho bot tải file <=20MB qua getFile, nên bot fallback sang MTProto
# (thư viện teleproto) để tải trực tiếp, đăng nhập LẠI CHÍNH bot ở BOT_TOKEN
# (không cần số điện thoại/OTP). BẮT BUỘC lấy 2 giá trị này tại
# https://my.telegram.org/apps (mục "API development tools", đăng nhập bằng
# SỐ ĐIỆN THOẠI của bạn — chỉ dùng để XIN cặp khoá app, không phải để đăng
# nhập MTProto bằng tài khoản đó). Để trống thì video >20MB sẽ báo lỗi
# không tải được thay vì tự fallback.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# BẮT BUỘC: video tạo xong (hoặc "404" khi lỗi) sẽ được đăng vào group này.
# Lấy chat id bằng cách thêm bot @userinfobot vào group (chat id thường là số âm).
GROUP_CHAT_ID=

# BẮT BUỘC để bot dùng được: Telegram user id của các admin được phép dùng
# bot, cách nhau bởi dấu phẩy (vd: 111111111,222222222). Để trống = không ai
# dùng được bot. Lấy user id bằng cách nhắn /start cho @userinfobot.
ADMINS=

# URL gốc của dịch vụ tạo video/ảnh AI
AIVIDEO_BASE_URL=https://hailuoai.video

# Đường dẫn URL trang tạo video/ảnh (điều chỉnh nếu khác)
AIVIDEO_CREATE_VIDEO_PATH=/create/video
AIVIDEO_CREATE_IMAGE_PATH=/create/image-generation
AIVIDEO_CREATE_VIDEO_REF_PATH=/create/subject-reference-to-video

# File lưu session (cookies/localStorage) sau khi chạy `npm run login` — tài
# khoản AIVideo dùng cho hàng đợi VIDEO.
STORAGE_STATE_PATH=./storage/session.json

# File lưu session cho tài khoản AIVideo RIÊNG dùng cho hàng đợi ẢNH — hàng
# đợi ảnh và video giờ chạy song song, độc lập nên bắt buộc phải là 2 TÀI
# KHOẢN AIVideo KHÁC NHAU (không dùng chung 1 tài khoản). Đăng nhập bằng
# `npm run login -- image` (khác `npm run login` — tài khoản video ở trên).
AIVIDEO_IMAGE_STORAGE_STATE_PATH=./storage/session-image.json

# Thư mục lưu video/ảnh tải về tạm thời trước khi gửi lên Telegram
DOWNLOAD_DIR=./storage/downloads

# Thư mục lưu ảnh tham chiếu tải từ Telegram (tính năng tạo ảnh) trước khi
# upload lên dịch vụ tạo video/ảnh AI
UPLOADS_DIR=./storage/uploads

# true = chạy ẩn (không hiện cửa sổ trình duyệt). Nên để false lúc đầu để dễ debug,
# và vì nhiều site có chống bot mạnh hơn khi chạy headless.
HEADLESS=false

# Thời gian tối đa chờ 1 video tạo xong (ms). Mặc định 10 phút.
GENERATION_TIMEOUT_MS=600000

# Playwright browser channel.
# - "chrome" (mặc định): dùng Google Chrome thật đã cài trên máy — cần thiết
#   khi CHẠY LỆNH `npm run login` để "Đăng nhập bằng Google" không bị chặn
#   với lỗi "This browser or app may not be secure". Yêu cầu đã cài Chrome.
# - "chromium": dùng Chromium bundled sẵn của Playwright, không cần cài
#   Chrome hệ thống — dùng cho VPS chỉ chạy bot để TÁI SỬ DỤNG session đã
#   đăng nhập sẵn (không đăng nhập Google trực tiếp trên VPS).
BROWSER_CHANNEL=chromium

# Bật "true" nếu chạy trong container/VPS báo lỗi sandbox namespace của
# Chrome (vd "No usable sandbox"). Chỉ bật khi thực sự cần thiết.
CHROME_NO_SANDBOX=true

# Tính năng "ChatAI": bot mở dịch vụ chat AI, điền prompt, chờ trả lời xong
# rồi lưu ra file. Đăng nhập riêng bằng `npm run login-chatai` (khác session
# với dịch vụ tạo video/ảnh AI).
CHATAI_BASE_URL=https://chatgpt.com
CHATAI_STORAGE_STATE_PATH=./storage/chatai-session.json
CHATAI_RESULTS_DIR=./storage/chatai-results

# Session RIÊNG (tài khoản KHÁC hẳn CHATAI_STORAGE_STATE_PATH ở trên) chỉ
# dùng để nhờ ChatAI viết lại prompt bị AIVideo từ chối vì vi phạm chính sách
# nội dung (reviseGenerationPrompt) — tách tài khoản vì tính năng này có thể
# chạy CÙNG LÚC với askChatAI. Đăng nhập bằng `npm run login-chatai -- revise`.
CHATAI_REVISE_STORAGE_STATE_PATH=./storage/chatai-revise-session.json

# Provider MỚI (pollo.ai) chạy song song với AIVideo — đăng nhập riêng bằng
# `npm run login-pollo`.
POLLO_BASE_URL=https://pollo.ai
POLLO_STORAGE_STATE_PATH=./storage/pollo-session.json

# Số video Pollo gen SONG SONG tối đa trên MÁY NÀY (worker-pool). Tài khoản
# pollo.ai cho phép tối đa 8 task song song — mặc định 2 (chừa biên an toàn
# cho job ảnh Pollo chạy chung tài khoản — xem thêm withPolloTaskSlot trong
# polloBrowser.ts, gate CHUNG chặn cứng tổng số task ảnh+video thật, không
# vượt quá giới hạn tài khoản dù 2 biến này đặt bao nhiêu).
# QUAN TRỌNG nếu CHẠY BOT TRÊN 2 MÁY KHÁC NHAU CÙNG DÙNG CHUNG 1 TÀI KHOẢN
# POLLO.AI: 2 máy là 2 process độc lập, KHÔNG chia sẻ được biến đếm trong bộ
# nhớ với nhau — phải TỰ CHIA TĨNH giá trị này cho từng máy sao cho TỔNG của
# tất cả các máy không vượt quá số task muốn dùng (vd máy A đặt 1, máy B đặt
# 1). Nếu để cả 2 máy cùng dùng mặc định, tổng thực tế sẽ nhân đôi.
POLLO_VIDEO_CONCURRENCY=2

# Số ảnh Pollo gen SONG SONG tối đa trên MÁY NÀY (worker-pool) — dùng CHUNG
# cho cả bước "Tạo ảnh" (CHARACTER/LOCATION) và "Tạo ảnh scene"
# (SCENE_SETTING_START/END). Cùng lưu ý chia tĩnh cho 2 máy khác nhau như
# POLLO_VIDEO_CONCURRENCY ở trên.
POLLO_IMAGE_CONCURRENCY=2

# Provider MỚI (ComfyUI, self-host, workflow LTX-2 frame-to-video) — gọi
# thẳng REST API của server ComfyUI, không dùng trình duyệt/session đăng
# nhập. Đổi URL nếu server ComfyUI chạy ở máy/port khác.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_GENERATION_TIMEOUT_MS=1200000

# Số sampling steps cho workflow MiniMax H3 "Reference to Video" (nhánh
# "Full", xem generateVideoComfyMiniMaxH3 trong comfyui.ts) — số càng cao
# chất lượng càng tốt nhưng chậm hơn.
COMFYUI_MINIMAX_H3_STEPS=8

# Độ phân giải đích (megapixel) cho workflow MiniMax H3 — mặc định 0.4 (vd ra
# 480x864 cho 9:16) khá thấp/không nét cho nội dung premium. Tăng lên (vd
# 1.0, gần 720p) cho hình nét hơn, đổi lại generate chậm hơn/tốn VRAM hơn.
COMFYUI_MINIMAX_H3_MEGAPIXELS=0.4

# true = trước khi gửi prompt, tự động chọn mức "reasoning effort" CAO NHẤT
# (thanh trượt cạnh ô nhập ChatAI) — trả lời chất lượng hơn nhưng chậm/tốn
# quota hơn. Mặc định false (giữ nguyên mức site đang để).
CHATAI_MAX_EFFORT=false

# Mode ChatAI dùng cho askChatAI/askChatAIWithInlineContent — "work" (chọn
# mode "Công việc"/Work + model "GPT-6 Astra" mức effort Medium) hoặc "chat"
# (mode "Trò chuyện"/Chat thường, không chọn model riêng). Mặc định "chat" —
# mode Work có quota RIÊNG ("5-hour limit"), tách biệt khỏi quota Chat, dễ
# hết đột ngột. Chỉ đổi sang "work" khi biết chắc quota đó còn.
CHATAI_MODE=chat

# (Tuỳ chọn) Proxy cho Playwright — áp dụng cho CẢ `npm run login` lẫn lúc
# bot chạy generate. Nên chạy cả 2 qua CÙNG proxy này để tránh đăng nhập từ
# 1 IP nhưng generate từ IP khác (dễ bị dịch vụ tạo video/ảnh AI/Google đánh
# dấu đáng ngờ). Định dạng: "ip:port" (mặc định = HTTP proxy — dùng cho hầu hết
# proxy thương mại/datacenter, kể cả khi tunnel traffic HTTPS đi qua). CHỈ
# dùng "https://ip:port" nếu nhà cung cấp xác nhận rõ đây là proxy yêu cầu
# TLS ngay tới chính proxy (hiếm gặp) — dùng nhầm scheme này sẽ khiến MỌI
# request bị treo/timeout (proxy không hiểu TLS handshake). "socks5://ip:port"
# nếu là proxy SOCKS5. Để trống PROXY_SERVER nếu không dùng proxy.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
