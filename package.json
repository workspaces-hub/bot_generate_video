{
  "name": "hailuo-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "start:xvfb": "xvfb-run -a --server-args='-screen 0 1920x1080x24 -dpi 96 +extension RANDR +extension GLX +render' node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "login": "tsx scripts/login.ts",
    "login-chatgpt": "tsx scripts/login-chatgpt.ts",
    "check-proxy": "tsx scripts/check-proxy.ts",
    "import-session": "tsx scripts/import-session.ts",
    "download-last-video": "tsx scripts/download-last-video.ts",
    "download-video": "tsx scripts/download-video-by-feed-id.ts",
    "check-session": "tsx scripts/check-session.ts",
    "check-credit": "tsx scripts/check-credit.ts",
    "check-chatgpt-model": "tsx scripts/check-chatgpt-model.ts",
    "generate-reference-images": "tsx scripts/generate-reference-images.ts",
    "generate-scene-images": "tsx scripts/generate-scene-images.ts",
    "generate-videos": "tsx scripts/generate-videos.ts",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "playwright": "^1.47.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
